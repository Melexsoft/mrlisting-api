{
  "name": "@mrlisting/api",
  "version": "0.1.0",
  "description": "Connect a directory frontend to the MrListing API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Melexsoft/mrlisting-api.git" },
  "keywords": ["api", "directory", "listings", "mrlisting"],
  "author": "Ferhat Ziba",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
