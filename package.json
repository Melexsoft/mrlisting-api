{
  "name": "@mrlisting/api",
  "version": "0.8.0",
  "description": "Connect a directory frontend to the MrListing API",
  "keywords": [
    "api",
    "directory",
    "listings",
    "mrlisting"
  ],
  "homepage": "https://github.com/Melexsoft/mrlisting-api#readme",
  "bugs": {
    "url": "https://github.com/Melexsoft/mrlisting-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melexsoft/mrlisting-api.git"
  },
  "license": "MIT",
  "author": "Ferhat Ziba",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "mrlisting-mcp": "dist/mcp.js"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "README.md",
    "EXAMPLES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js",
  "sideEffects": false
}
